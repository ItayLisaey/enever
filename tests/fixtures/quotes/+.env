# Double quoted values
DOUBLE_QUOTED="hello world"
DOUBLE_WITH_SPACES="  spaces around  "
DOUBLE_WITH_EQUALS="key=value"

# Single quoted values
SINGLE_QUOTED='hello world'
SINGLE_WITH_SPACES='  spaces around  '

# Nested quotes
NESTED_QUOTES="He said 'hello' to me"
NESTED_DOUBLE='She said "goodbye" to him'

# Empty quoted
EMPTY_DOUBLE=""
EMPTY_SINGLE=''
