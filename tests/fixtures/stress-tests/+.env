# ================================================================
# THE FINAL BOSS OF .ENV TESTING
# If a parser can handle every line here, it is bulletproof.
# ================================================================

# ----------------------------------------------------------------
# 1. WHITESPACE & STRUCTURAL TORTURE
# ----------------------------------------------------------------

   LEADING_SPACES_KEY=value
KEY_SPACES_BEFORE_EQ   =value
KEY_SPACES_AFTER_EQ=   value
KEY_TRAILING_SPACES="value"
   export INDENTED_EXPORT=value
KEY_SPACES_EVERYWHERE = " value "
EMPTY_NO_VALUE=
EMPTY_QUOTED=""
KEY_WITH_NO_EQUALS
TABS_AROUND	=	tabbed_value

# ----------------------------------------------------------------
# 2. QUOTING & ESCAPING GAUNTLET
# ----------------------------------------------------------------

SINGLE_IN_DOUBLE="It's 'fine'"
DOUBLE_IN_SINGLE='He said "Hello"'
ESCAPED_QUOTE="backslash \" works"
LITERAL_BACKSLASH="C:\\Users\\Node"
MULTILINE_QUOTED="Line one
Line two"
ESCAPED_NEWLINE="First line\nSecond line"
ESCAPED_TAB="Tab\there"
SINGLE_QUOTE_LITERAL='No $expansion here'
MIXED_ESCAPES="Path: C:\\dir\\file\tTab\nNewline"

# ----------------------------------------------------------------
# 3. COMMENT & SPECIAL CHARACTER MINEFIELD
# ----------------------------------------------------------------

KEY_HASH_NO_SPACE=value#comment
KEY_HASH_WITH_SPACE=value # comment
HASH_IN_QUOTES="#notacomment"
URL_WITH_FRAGMENT="http://example.com/api?v=1#fragment"
EQUAL_IN_VALUE="key=value"
MULTIPLE_EQUALS=a=b=c=d
CHINESE_VALUE="你好世界"
ARABIC_VALUE="مرحبا"
RUSSIAN_VALUE="Привет мир"
JAPANESE_VALUE="こんにちは"
JSON_SIMPLE='{"key": "value"}'
JSON_NESTED='{"user": {"name": "John", "age": 30}}'

# ----------------------------------------------------------------
# 4. VARIABLE INTERPOLATION (Standard .env behavior)
# ----------------------------------------------------------------

BASE_VAR=base_value
VAR_BASIC=$BASE_VAR
VAR_BRACED=${BASE_VAR}
VAR_IN_STRING="Pre-$BASE_VAR-Post"
VAR_SINGLE_NO_EXPAND='$BASE_VAR'
ESCAPED_DOLLAR="\$100"
DOLLAR_NO_VAR=$
DOLLAR_END="value$"
PARTIAL_VAR=${INCOMPLETE

# ----------------------------------------------------------------
# 5. EXTREME EDGE CASES
# ----------------------------------------------------------------

# Path traversal attempt (should just be a string value)
PATH_TRAVERSAL="../../../etc/passwd"

# Null-like values
NULL_STRING=null
NULL_CAPS=NULL
UNDEFINED_STRING=undefined

# Boolean-like values
BOOL_TRUE=true
BOOL_FALSE=false
BOOL_YES=yes
BOOL_NO=no
BOOL_ONE=1
BOOL_ZERO=0

# Numeric edge cases
NEGATIVE_NUM=-42
FLOAT_NUM=3.14159
SCIENTIFIC=1.23e10
HEX_VALUE=0xDEADBEEF

# Special characters in unquoted values
AMPERSAND_UNQUOTED=a&b
PIPE_UNQUOTED=a|b
SEMICOLON_UNQUOTED=a;b
BACKTICK_QUOTED="`command`"
DOLLAR_PARENS_QUOTED="$(command)"

# Extremely long key
VERY_LONG_KEY_NAME_THAT_GOES_ON_AND_ON_AND_ON_AND_ON_ABCDEFGHIJKLMNOPQRSTUVWXYZ=longkey

# Whitespace-only value
WHITESPACE_ONLY="   "

# Value with leading/trailing quotes (not quote delimiters)
EMBEDDED_QUOTES=value"with"quotes

# Mixed quote styles in value
MIXED_STYLE_QUOTES="don't do this'

