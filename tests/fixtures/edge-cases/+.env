# Unicode and emoji
EMOJI=Hello World
CJK=
JAPANESE=
KOREAN=

# URLs with special characters
DATABASE_URL=postgres://user:p@ssw0rd!@localhost:5432/db?sslmode=require
OAUTH_CALLBACK=https://example.com/callback?code=abc&state=xyz

# Values with equals signs
CONNECTION_STRING=Server=localhost;Database=mydb;User=admin;Password=secret=123

# Values with hash (not a comment)
COLOR="#ff0000"
REGEX="^[a-z]+$"

# Keys with special characters
MY-VAR=value-with-hyphen
MY.VAR=value.with.dot
VAR_123=value_with_numbers

# Empty value
EMPTY_VALUE=

# Value with only spaces
SPACES_VALUE="   "

# Very long value
LONG_VALUE=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
